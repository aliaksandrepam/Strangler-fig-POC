@model PocApp.Models.Project
@{
    ViewData["Title"] = "Delete project";
}

<h2 class="text-danger">Delete project?</h2>
<p>This will also delete the project's tasks. This cannot be undone.</p>

<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Owner</dt><dd class="col-sm-9">@(Model.Owner?.FullName ?? Model.Owner?.Email)</dd>
    <dt class="col-sm-3">Tasks</dt><dd class="col-sm-9">@Model.Tasks.Count</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
