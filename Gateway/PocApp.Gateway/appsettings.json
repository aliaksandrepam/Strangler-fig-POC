{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "auth-to-authapi": {
        "ClusterId": "auth-api",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "signalr-to-mvc": {
        "ClusterId": "mvc",
        "Match": { "Path": "/hubs/{**catch-all}" }
      },
      "api-to-projects": {
        "ClusterId": "projects-api",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "mfe-vite-hmr": {
        "ClusterId": "vite",
        "Match": { "Path": "/projects/new/{**catch-all}" }
      },
      "vite-internal": {
        "ClusterId": "vite",
        "Match": { "Path": "/@vite/{**catch-all}" }
      },
      "vite-fs": {
        "ClusterId": "vite",
        "Match": { "Path": "/@fs/{**catch-all}" }
      },
      "vite-id": {
        "ClusterId": "vite",
        "Match": { "Path": "/@id/{**catch-all}" }
      },
      "vite-node-modules": {
        "ClusterId": "vite",
        "Match": { "Path": "/node_modules/{**catch-all}" }
      },
      "vite-src": {
        "ClusterId": "vite",
        "Match": { "Path": "/src/{**catch-all}" }
      },
      "fallback-to-mvc": {
        "ClusterId": "mvc",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "mvc": {
        "Destinations": {
          "mvc1": { "Address": "http://localhost:5205/" }
        }
      },
      "projects-api": {
        "Destinations": {
          "api1": { "Address": "http://localhost:5206/" }
        }
      },
      "auth-api": {
        "Destinations": {
          "auth1": { "Address": "http://localhost:5208/" }
        }
      },
      "vite": {
        "Destinations": {
          "vite1": { "Address": "http://localhost:5173/" }
        }
      }
    }
  }
}
